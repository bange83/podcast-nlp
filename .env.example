# Optional: Hugging Face Token für pyannote.audio Sprechererkennung
# Token erstellen unter: https://huggingface.co/settings/tokens
# Bedingungen akzeptieren unter:
# 1. https://huggingface.co/pyannote/speaker-diarization-3.1
# 2. https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_dein_token_hier

# Optional: Standard Ollama Modell (Standard: qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:14b
